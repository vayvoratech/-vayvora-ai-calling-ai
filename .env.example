# ==============================================================================
# Voice Agent Environment Configuration (Safe Template)
# Copy this file to .env and fill in real values for local testing.
# NEVER commit real credentials to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider Configuration (gemini / huggingface)
LLM_PROVIDER=gemini

# Google Gemini LLM Provider (Primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_TEMPERATURE=0.2

# Hugging Face / Qwen LLM Provider (Optional Alternate)
HF_API_KEY=your_huggingface_api_key_here
HF_MODEL=Qwen/Qwen3-32B
HF_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT_SECONDS=60.0
HF_TEMPERATURE=0.2

# Redis Stack for Grounded RAG (Phase 4)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Model Context Protocol (MCP) Tools (Phase 5)
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_ENABLED=true

# Local Audio Engines: VAD, STT & TTS (Phase 7)
VAD_PROVIDER=silero
VAD_SAMPLE_RATE=16000
VAD_START_THRESHOLD=0.45
VAD_END_THRESHOLD=0.20
VAD_MIN_SPEECH_DURATION_MS=160
VAD_MIN_SILENCE_DURATION_MS=400
VAD_PRE_ROLL_MS=300
PRE_STT_MIN_DURATION_MS=200
PRE_STT_MIN_RMS=120.0

# Real-Time Background Noise Suppression (WebRTC APM + High-Pass + Soft Gate)
NOISE_SUPPRESSION_ENABLED=true
NOISE_SUPPRESSION_LEVEL=2
HIGH_PASS_FILTER_ENABLED=true
NOISE_GATE_ENABLED=true
NOISE_GATE_THRESHOLD_DB=-42.0

# Real-Time Cloud Voice Engines: Groq Whisper STT & Deepgram Streaming TTS
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo

DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_TTS_MODEL=aura-asteria-en
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_SAMPLE_RATE=48000

STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=5

TTS_PROVIDER=deepgram
TTS_VOICE=aura-asteria-en
TTS_LANGUAGE=en-us
TTS_SAMPLE_RATE=48000
TTS_OUTPUT_FORMAT=linear16

# External Telephony Transport Integration (Phase 9)
TELEPHONY_TRANSPORT=mock
TELEPHONY_ENDPOINT=
TELEPHONY_CONNECTION_TIMEOUT=10.0
TELEPHONY_AUDIO_SAMPLE_RATE=16000
TELEPHONY_AUDIO_CHANNELS=1
TELEPHONY_FRAME_DURATION=0.02

# ==============================================================================
# SMTP Email Sending Configuration
# ==============================================================================
# Controls the outbound email delivery system (SMTPEmailProvider).
# When SMTP_HOST is set to a remote server (e.g., smtp.gmail.com), the system
# automatically activates live SMTP dispatch instead of the mock provider.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10.0

# ==============================================================================
# IMAP Email Inbox Reading Configuration
# ==============================================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your_email@gmail.com
IMAP_PASSWORD=your_16_char_app_password
IMAP_TIMEOUT_SECONDS=10.0

# ==============================================================================
# WhatsApp Messaging Configuration (OpenWA)
# ==============================================================================
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=your_openwa_api_key_here
WHATSAPP_SESSION_ID=default

# ==============================================================================
# Calendar Storage Configuration
# ==============================================================================
CALENDAR_EVENTS_PATH=data/events.json
